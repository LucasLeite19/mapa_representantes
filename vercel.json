{
  "rewrites": [
    {
      "source": "/api/ibge/:path*",
      "destination": "https://servicodados.ibge.gov.br/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
